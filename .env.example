# -----------------------------------------------------------------------------
# PRAGMA — Environment Variables Template
# Copy this file to .env.local and fill in your keys:
# cp .env.example .env.local
# -----------------------------------------------------------------------------

# DreamDEX — Shannon Testnet (Chain ID 50312)
NEXT_PUBLIC_DREAMDEX_REST_URL=https://stg.api.dreamdex.io/v0
NEXT_PUBLIC_DREAMDEX_WS_URL=wss://stg.api.dreamdex.io/v0/ws/public
NEXT_PUBLIC_DREAMDEX_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_CHAIN_ID=50312

# AI Decision Engine (Server-only)
# Primary: Groq (Llama 3.3 70B) — https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
# Fallback: OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1_your_openrouter_api_key_here

# Supabase Realtime & Persistence
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Telegram Bot Alerts & Commands
# Token from @BotFather, Chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_from_userinfobot

# Somnia Shannon Testnet Operator Wallet (Server-only)
AGENT_PRIVATE_KEY=0x_your_operator_private_key_here
AGENT_PUBLIC_KEY=0x_your_operator_public_address_here
